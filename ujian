<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Garis Bilangan Interaktif - Bilangan Bulat</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f0f4f8;
            color: #1e293b;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
            margin: 0;
        }
        .container {
            background: white;
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            max-width: 900px;
            width: 100%;
            text-align: center;
        }
        h1 {
            color: #0f172a;
            margin-bottom: 5px;
            font-size: 1.6rem;
        }
        p.subtitle {
            color: #64748b;
            margin-top: 0;
            margin-bottom: 20px;
        }
        .controls {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            background: #f8fafc;
            padding: 15px;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            margin-bottom: 20px;
        }
        input[type="number"], select {
            padding: 10px;
            font-size: 1.2rem;
            border: 2px solid #cbd5e1;
            border-radius: 8px;
            width: 80px;
            text-align: center;
            font-weight: bold;
        }
        select {
            width: 70px;
            background-color: #e0f2fe;
            border-color: #38bdf8;
            color: #0369a1;
            cursor: pointer;
        }
        button {
            padding: 10px 20px;
            font-size: 1rem;
            font-weight: bold;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: transform 0.1s, background-color 0.2s;
        }
        button:active {
            transform: scale(0.96);
        }
        .btn-play {
            background-color: #2563eb;
            color: white;
        }
        .btn-play:hover {
            background-color: #1d4ed8;
        }
        .btn-reset {
            background-color: #e2e8f0;
            color: #475569;
        }
        .btn-reset:hover {
            background-color: #cbd5e1;
        }
        .canvas-wrapper {
            width: 100%;
            overflow-x: auto;
            margin: 10px 0;
        }
        canvas {
            background: #ffffff;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            display: block;
            margin: 0 auto;
        }
        .status-box {
            margin-top: 15px;
            padding: 15px;
            background-color: #fef3c7;
            border-left: 5px solid #f59e0b;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: 500;
            color: #92400e;
            min-height: 28px;
        }
        .rules {
            margin-top: 20px;
            text-align: left;
            background: #f1f5f9;
            padding: 15px 20px;
            border-radius: 10px;
            font-size: 0.95rem;
            color: #334155;
        }
        .rules h3 {
            margin-top: 0;
            margin-bottom: 8px;
            font-size: 1rem;
        }
        .rules ul {
            margin: 0;
            padding-left: 20px;
        }
        .rules li {
            margin-bottom: 4px;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>Garis Bilangan Interaktif</h1>
    <p class="subtitle">Media Pembelajaran Penjumlahan & Pengurangan Bilangan Bulat</p>

    <div class="controls">
        <input type="number" id="num1" value="3" min="-10" max="10" title="Bilangan Pertama (-10 s.d. 10)">
        <select id="operator" title="Operasi">
            <option value="+">+</option>
            <option value="-">-</option>
        </select>
        <input type="number" id="num2" value="-5" min="-10" max="10" title="Bilangan Kedua (-10 s.d. 10)">
        <button class="btn-play" id="btnStart" onclick="startAnimation()">▶ Mulai Animasi</button>
        <button class="btn-reset" onclick="resetCanvas()">↺ Reset</button>
    </div>

    <div class="canvas-wrapper">
        <canvas id="numberLineCanvas" width="840" height="230"></canvas>
    </div>

    <div class="status-box" id="statusText">
        Masukkan angka (antara -10 sampai 10), lalu klik <b>Mulai Animasi</b>.
    </div>

    <div class="rules">
        <h3>💡 Aturan Pergerakan Karakter:</h3>
        <ul>
            <li><b>Posisi Awal:</b> Karakter mulai berdiri di titik <b>0</b> menghadap ke kanan.</li>
            <li><b>Bilangan Positif (+):</b> Karakter melangkah <b>maju</b> ke arah kanan.</li>
            <li><b>Bilangan Negatif (-):</b> Karakter berbalik arah (menghadap kiri) lalu melangkah.</li>
            <li><b>Operasi Pengurangan (-):</b> Karakter berbalik arah terlebih dahulu sebelum melangkah untuk bilangan kedua.</li>
        </ul>
    </div>
</div>

<script>
    const canvas = document.getElementById('numberLineCanvas');
    const ctx = canvas.getContext('2d');
    const statusText = document.getElementById('statusText');
    const btnStart = document.getElementById('btnStart');

    const minVal = -12;
    const maxVal = 12;
    const padding = 40;
    const lineY = 160;
    const stepWidth = (canvas.width - padding * 2) / (maxVal - minVal);

    let currentPos = 0;
    let facing = 1; // 1 = kanan, -1 = kiri
    let animationId = null;
    let arcs = []; // Menyimpan jejak lengkungan lompatan

    function valToX(val) {
        return padding + (val - minVal) * stepWidth;
    }

    function drawNumberLine() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // Garis utama
        ctx.beginPath();
        ctx.moveTo(padding - 15, lineY);
        ctx.lineTo(canvas.width - padding + 15, lineY);
        ctx.strokeStyle = '#334155';
        ctx.lineWidth = 3;
        ctx.stroke();

        // Panah ujung kiri & kanan
        drawArrowHead(padding - 20, lineY, Math.PI);
        drawArrowHead(canvas.width - padding + 20, lineY, 0);

        // Titik dan angka
        for (let i = minVal; i <= maxVal; i++) {
            const x = valToX(i);
            ctx.beginPath();
            ctx.moveTo(x, lineY - 8);
            ctx.lineTo(x, lineY + 8);
            ctx.strokeStyle = i === 0 ? '#ef4444' : '#334155';
            ctx.lineWidth = i === 0 ? 3 : 2;
            ctx.stroke();

            ctx.font = i === 0 ? 'bold 16px sans-serif' : '14px sans-serif';
            ctx.fillStyle = i === 0 ? '#ef4444' : '#1e293b';
            ctx.textAlign = 'center';
            ctx.fillText(i, x, lineY + 28);
        }

        // Gambar jejak lengkungan (arcs)
        arcs.forEach(arc => {
            drawJumpArc(arc.from, arc.to, arc.color, arc.heightOffset);
        });

        // Gambar karakter
        drawCharacter(currentPos, facing);
    }

    function drawArrowHead(x, y, angle) {
        ctx.save();
        ctx.translate(x, y);
        ctx.rotate(angle);
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.lineTo(-10, -6);
        ctx.lineTo(-10, 6);
        ctx.closePath();
        ctx.fillStyle = '#334155';
        ctx.fill();
        ctx.restore();
    }

    function drawJumpArc(from, to, color, heightOffset) {
        if (from === to) return;
        const startX = valToX(from);
        const endX = valToX(to);
        const midX = (startX + endX) / 2;
        const controlY = lineY - heightOffset;

        ctx.beginPath();
        ctx.moveTo(startX, lineY - 5);
        ctx.quadraticCurveTo(midX, controlY, endX, lineY - 5);
        ctx.strokeStyle = color;
        ctx.lineWidth = 2.5;
        ctx.setLineDash([5, 5]);
        ctx.stroke();
        ctx.setLineDash([]);
    }

    function drawCharacter(pos, dir) {
        const x = valToX(pos);
        const y = lineY - 22;

        // Badan lingkaran
        ctx.beginPath();
        ctx.arc(x, y, 14, 0, Math.PI * 2);
        ctx.fillStyle = '#3b82f6';
        ctx.fill();
        ctx.lineWidth = 2;
        ctx.strokeStyle = '#1d4ed8';
        ctx.stroke();

        // Mata (menunjukkan arah hadap)
        const eyeOffsetX = dir === 1 ? 5 : -5;
        ctx.beginPath();
        ctx.arc(x + eyeOffsetX, y - 3, 3, 0, Math.PI * 2);
        ctx.fillStyle = 'white';
        ctx.fill();

        // Paruh / Penunjuk arah
        ctx.beginPath();
        if (dir === 1) {
            ctx.moveTo(x + 14, y);
            ctx.lineTo(x + 21, y - 3);
            ctx.lineTo(x + 14, y + 4);
        } else {
            ctx.moveTo(x - 14, y);
            ctx.lineTo(x - 21, y - 3);
            ctx.lineTo(x - 14, y + 4);
        }
        ctx.fillStyle = '#f59e0b';
        ctx.fill();
    }

    function sleep(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }

    function resetCanvas() {
        currentPos = 0;
        facing = 1;
        arcs = [];
        btnStart.disabled = false;
        statusText.innerHTML = "Posisi direset ke <b>0</b>. Silakan mulai simulasi.";
        drawNumberLine();
    }

    async function startAnimation() {
        const n1 = parseInt(document.getElementById('num1').value);
        const op = document.getElementById('operator').value;
        const n2 = parseInt(document.getElementById('num2').value);

        if (isNaN(n1) || isNaN(n2) || n1 < -10 || n1 > 10 || n2 < -10 || n2 > 10) {
            alert("Masukkan bilangan bulat antara -10 hingga 10!");
            return;
        }

        const finalResult = op === '+' ? n1 + n2 : n1 - n2;
        if (finalResult < minVal || finalResult > maxVal) {
