/**
 * 2. VERIFIKASI LOGIN SISWA
 */
function verifyStudentLogin(nama, token) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheetSiswa = ss.getSheetByName("Master_Siswa");
  if (!sheetSiswa) {
    return { success: false, message: "Database Master_Siswa belum diinisialisasi!" };
  }

  const data = sheetSiswa.getDataRange().getValues();
  const cleanNama = String(nama).trim().toLowerCase();
  const cleanToken = String(token).trim().toUpperCase();

  for (let i = 1; i < data.length; i++) {
    const rowNama = String(data[i][0]).trim().toLowerCase();
    const rowKelas = String(data[i][1]).trim();
    const rowToken = String(data[i][2]).trim().toUpperCase();

    if (rowNama === cleanNama && rowToken === cleanToken) {
      // Cek apakah siswa sudah pernah mengumpulkan ujian (opsional, mencegah ujian ganda)
      const sheetHasil = ss.getSheetByName("Hasil_Ujian");
      if (sheetHasil) {
        const hasilData = sheetHasil.getDataRange().getValues();
        for (let j = 1; j < hasilData.length; j++) {
          if (String(hasilData[j][1]).trim().toLowerCase() === cleanNama && String(hasilData[j][2]).trim() === rowKelas) {
            return { 
              success: false, 
              message: "Anda sudah menyelesaikan ujian ini sebelumnya. Hubungi pengawas jika ingin mengulang." 
            };
          }
        }
      }

      return {
        success: true,
        student: {
          nama: String(data[i][0]).trim(),
          kelas: rowKelas,
          token: rowToken
        }
      };
    }
  }

  return { success: false, message: "Nama Siswa atau Token Akses tidak valid!" };
}

/**
 * 3. VERIFIKASI LOGIN ADMIN / GURU
 */
function verifyAdminLogin(password) {
  const inputPass = String(password).trim();
  // Mendukung password dari APP_CONFIG ("123") maupun "admincbt123" sesuai spesifikasi
  if (inputPass === APP_CONFIG.PASSWORD_ADMIN || inputPass === "admincbt123") {
    return { success: true };
  }
  return { success: false, message: "Password Admin / Guru salah!" };
}

